# KoiosBase is a Rust-only repository now (2026-10-08): the Python shell
# (koiosbase/), its tests and its venv were removed. These entries stay so a
# stray __pycache__ generated by any tooling never gets committed by accident.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
build/
dist/

# KoiosBase vaults: derived indices are ALWAYS rebuildable from raw/ + wiki/
# and must never be committed (P1 — Markdown is the single source of truth).
.index/
*.db

.DS_Store

# Rust shell (rust-cli/): build artifacts are derived; Cargo.lock is pinned
# per-crate and regenerated on every build, so it does not belong in the repo
# for a binary target.
rust-cli/target/
rust-cli/Cargo.lock
